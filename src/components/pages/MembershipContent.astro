---
import { Image } from 'astro:assets';
import HeroBanner from '../HeroBanner.astro';
import gemeinschaft from '../../assets/gemeinschaft.png';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const m = {
  de: { introTitle: 'Werde Teil unseres Vereins', antragDesc: 'PDF-Formular zum Ausfüllen und Einsenden', antragBtn: 'Mitgliedsantrag (PDF)', sepaBtn: 'SEPA-Lastschriftmandat (PDF)' },
  en: { introTitle: 'Become part of our association', antragDesc: 'PDF form to fill out and send in', antragBtn: 'Membership Application (PDF)', sepaBtn: 'SEPA Direct Debit Mandate (PDF)' },
  fr: { introTitle: 'Rejoignez notre association', antragDesc: 'Formulaire PDF à remplir et à renvoyer', antragBtn: "Formulaire d'adhésion (PDF)", sepaBtn: 'Mandat de prélèvement SEPA (PDF)' },
}[lang];

const icons = {
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  card: '<rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/>',
  file: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v5h5"/>',
  download: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/>',
};

const dlBtn = 'inline-flex items-center gap-2 rounded-md bg-orange-500 px-4 py-2 text-sm font-medium text-white transition hover:bg-orange-600';
---

<HeroBanner title={t('membership.title')} subtitle={t('membership.subtitle')} />

<section class="pt-8 pb-16 md:pt-12 md:pb-24">
  <div class="container max-w-6xl">
    <div class="grid gap-8 md:grid-cols-2">
      <!-- Linke Spalte -->
      <div class="space-y-6">
        <div class="group rounded-lg border border-border bg-card text-card-foreground shadow-sm overflow-hidden animate-fade-up">
          <div class="relative h-40 overflow-hidden">
            <Image src={gemeinschaft} alt={m.introTitle} widths={[400, 800]} sizes="(max-width: 768px) 100vw, 400px" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-background/60 to-transparent"></div>
            <div class="absolute bottom-3 left-3 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-primary-foreground shadow-lg">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.users} />
            </div>
          </div>
          <div class="pt-4 pb-2 px-6"><h2 class="text-xl font-semibold">{m.introTitle}</h2></div>
          <div class="px-6 pb-6"><p class="text-base leading-relaxed text-muted-foreground">{t('membership.intro')}</p></div>
        </div>

        <div class="group rounded-lg border border-border bg-card text-card-foreground shadow-sm overflow-hidden animate-fade-up animation-delay-100">
          <div class="relative h-40 overflow-hidden">
            <img src="/images/photo-1579621970563-ebec7560ff3e.jpg" alt={t('membership.fee.title')} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-background/60 to-transparent"></div>
            <div class="absolute bottom-3 left-3 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-blue-500 text-white shadow-lg">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.card} />
            </div>
          </div>
          <div class="pt-4 pb-2 px-6"><h2 class="text-xl font-semibold">{t('membership.fee.title')}</h2></div>
          <div class="px-6 pb-6"><p class="text-base text-muted-foreground">{t('membership.fee.text')}</p></div>
        </div>
      </div>

      <!-- Rechte Spalte -->
      <div class="space-y-6">
        <div class="group rounded-lg border border-border bg-card text-card-foreground shadow-sm overflow-hidden animate-fade-up animation-delay-200">
          <div class="relative h-40 overflow-hidden">
            <img src="/images/photo-1554224155-8d04cb21cd6c.jpg" alt={t('membership.title')} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-background/60 to-transparent"></div>
            <div class="absolute bottom-3 left-3 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-primary-foreground shadow-lg">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.file} />
            </div>
          </div>
          <div class="pt-4 pb-2 px-6"><h2 class="text-xl font-semibold">{t('membership.title')}</h2></div>
          <div class="px-6 pb-6 space-y-4">
            <p class="text-base text-muted-foreground">{m.antragDesc}</p>
            <a href="/documents/mitgliedsantrag-2026-01-25.pdf" target="_blank" rel="noopener noreferrer" class={dlBtn}>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.download} />
              {m.antragBtn}
            </a>
          </div>
        </div>

        <div class="group rounded-lg border border-border bg-card text-card-foreground shadow-sm overflow-hidden animate-fade-up animation-delay-300">
          <div class="relative h-40 overflow-hidden">
            <img src="/images/photo-1563013544-824ae1b704d3.jpg" alt={t('membership.sepa.title')} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-background/60 to-transparent"></div>
            <div class="absolute bottom-3 left-3 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-primary-foreground shadow-lg">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.file} />
            </div>
          </div>
          <div class="pt-4 pb-2 px-6"><h2 class="text-xl font-semibold">{t('membership.sepa.title')}</h2></div>
          <div class="px-6 pb-6 space-y-4">
            <p class="text-base text-muted-foreground">{t('membership.sepa.text')}</p>
            <a href="/documents/sepa-lastschriftmandat.pdf" target="_blank" rel="noopener noreferrer" class={dlBtn}>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.download} />
              {m.sepaBtn}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
