---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404">
  <section class="flex min-h-[60vh] items-center justify-center">
    <div class="text-center">
      <h1 class="mb-4 text-5xl font-bold text-foreground">404</h1>
      <p class="mb-6 text-xl text-muted-foreground">Diese Seite wurde nicht gefunden.</p>
      <a href="/" class="inline-flex items-center rounded-lg bg-orange-500 px-6 py-3 font-medium text-white transition hover:bg-orange-600">Zur Startseite</a>
    </div>
  </section>
</Layout>
